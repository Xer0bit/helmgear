# Copy to .env (git-ignored) and fill in. Never paste a key into a chat or a commit.

# Required: the model.
DEEPSEEK_API_KEY=

# Recommended: Jev picks the agent and checks each reply against what the agent did.
TYPESAFE_API_KEY=

# Web research. Default is a self-hosted Firecrawl on this machine; start it with: pnpm firecrawl:up
# FIRECRAWL_URL=http://127.0.0.1:3002

# Real email over SMTP. Without these, "send" writes a file under the state folder instead.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=
# SMTP_FROM=Your Name <you@example.com>

# Posting on X: an OAuth 2.0 user access token with the tweet.write scope.
# X_ACCESS_TOKEN=

# Tokens for MCP servers listed in connectors.json, referenced there as ${NAME}.
# LINKEDIN_MCP_TOKEN=
# ACCOUNTING_MCP_TOKEN=

# Knowledge base: add embedding search on top of keyword search (a text-embeddings-inference server).
# HELMGEAR_EMBEDDINGS_URL=http://127.0.0.1:8088
# HELMGEAR_EMBEDDINGS_QUERY_PREFIX=
