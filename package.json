{
  "name": "helmgear",
  "version": "0.2.2-rc.3",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.9.0"
  },
  "workspaces": [
    "vendor/*",
    "packages/*/*",
    "native/system",
    "native/system/packages/*",
    "apps/*",
    "website"
  ],
  "scripts": {
    "helmgear": "node --import tsx/esm apps/cli/src/bin.ts",
    "typecheck": "tsc -b tsconfig.host.json",
    "test": "vitest run",
    "build:native": "tsx native/system/scripts/build.ts --host-addon-only",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@helmgear/tool-executor-native": "workspace:*",
    "@helmgear/tool-executor-ptc": "workspace:*",
    "@helmgear/agent": "workspace:*",
    "@helmgear/llm-replay": "workspace:*",
    "@helmgear/llm": "workspace:*",
    "@helmgear/mcp-client": "workspace:*",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.3",
    "@types/mdast": "^4.0.4",
    "@types/papaparse": "^5.5.2",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@types/semver": "^7.8.0",
    "@types/spdx-expression-parse": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@yao-pkg/pkg": "6.21.0",
    "@yarnpkg/cli-dist": "4.18.0",
    "diff": "^9.0.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "execa": "^10.0.1",
    "zod": "4.6.6",
    "extract-zip": "^2.0.1",
    "fast-check": "^4.9.0",
    "fflate": "^0.8.2",
    "istanbul-lib-report": "^3.0.1",
    "js-yaml": "^4.3.2",
    "jscpd": "^5.1.2",
    "jsdom": "29.1.1",
    "lefthook": "^2.1.12",
    "lightningcss": "^1.33.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mermaid": "11.17.2",
    "micromark-extension-gfm": "^3.0.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "papaparse": "5.5.3",
    "pnpm": "11.28.5",
    "publint": "^0.3.24",
    "semver": "^7.8.5",
    "smol-toml": "^1.9.0",
    "spdx-expression-parse": "^5.0.0",
    "tar": "^7.5.22",
    "tsdown": "^0.22.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "8.2.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11",
    "@helmgear/working-directory": "workspace:*"
  }
}
