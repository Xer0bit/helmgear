{
  "name": "@helmgear/runner",
  "description": "The one function an application calls: route a request to a template, run the agent with only that template's tools, and return the result with any actions waiting for approval",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "dependencies": {
    "@helmgear/gateway": "workspace:*",
    "@helmgear/router": "workspace:*",
    "@helmgear/sdk-client": "workspace:*",
    "@helmgear/template": "workspace:*"
  },
  "devDependencies": {
    "yaml": "^2.4.2"
  }
}
