{
  "name": "@helmgear/anonymous-user-id",
  "description": "Shared anonymous user identity for Helmgear telemetry and feedback correlation",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@helmgear/brand": "workspace:*",
    "@helmgear/home-paths": "workspace:*",
    "@helmgear/cordis": "workspace:~"
  },
  "devDependencies": {
    "@helmgear/brand": "workspace:*",
    "@helmgear/home-paths": "workspace:*",
    "@helmgear/cordis": "workspace:~"
  }
}
