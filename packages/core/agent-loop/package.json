{
  "name": "@helmgear/agent-loop",
  "description": "The concrete agent loop plugin for the Helmgear",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@helmgear/cordis": "workspace:~",
    "@helmgear/agent": "workspace:*",
    "@helmgear/llm": "workspace:*",
    "@helmgear/scope": "workspace:*",
    "@helmgear/session": "workspace:*",
    "@helmgear/session-persistence": "workspace:*",
    "@helmgear/session-projection": "workspace:*",
    "@helmgear/system-prompt": "workspace:*",
    "@helmgear/tools": "workspace:*"
  },
  "dependencies": {
    "@helmgear/brand": "workspace:*",
    "@helmgear/util-values": "workspace:*",
    "@helmgear/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@helmgear/llm-deepseek-api-key": "workspace:*",
    "@helmgear/cordis": "workspace:~",
    "@helmgear/llm-pi-ai": "workspace:*",
    "@helmgear/agent": "workspace:*",
    "@helmgear/llm": "workspace:*",
    "@helmgear/scope": "workspace:*",
    "@helmgear/session": "workspace:*",
    "@helmgear/session-persistence": "workspace:*",
    "@helmgear/session-persistence-jsonl": "workspace:*",
    "@helmgear/session-projection": "workspace:*",
    "@helmgear/system-prompt": "workspace:*",
    "@helmgear/tool-executor-native": "workspace:*",
    "@helmgear/tool-executor-ptc": "workspace:*",
    "@helmgear/tool-testkit": "workspace:*",
    "@helmgear/tools": "workspace:*"
  }
}
