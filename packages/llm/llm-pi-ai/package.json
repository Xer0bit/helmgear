{
  "name": "@helmgear/llm-pi-ai",
  "description": "pi-ai-backed DeepSeek adapter for the Helmgear LLM seam (design-verification twin of helmgear-llm-deepseek)",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@helmgear/cordis": "workspace:~",
    "@helmgear/cordis-plugin-loader": "workspace:~",
    "@helmgear/attachment": "workspace:*",
    "@helmgear/authorization": "workspace:*",
    "@helmgear/credentials": "workspace:*",
    "@helmgear/fs": "workspace:*",
    "@helmgear/launch-environment": "workspace:*",
    "@helmgear/llm": "workspace:*",
    "@helmgear/timeout": "workspace:*"
  },
  "dependencies": {
    "@helmgear/brand": "workspace:*",
    "@helmgear/util-values": "workspace:*",
    "@helmgear/schemastery": "workspace:~",
    "@earendil-works/pi-ai": "^1.3.0"
  },
  "devDependencies": {
    "@helmgear/cordis": "workspace:~",
    "@helmgear/cordis-plugin-loader": "workspace:~",
    "@helmgear/agent-loop-testkit": "workspace:*",
    "@helmgear/attachment": "workspace:*",
    "@helmgear/authorization": "workspace:*",
    "@helmgear/credentials": "workspace:*",
    "@helmgear/fs": "workspace:*",
    "@helmgear/http-proxy": "workspace:*",
    "@helmgear/launch-environment": "workspace:*",
    "@helmgear/llm": "workspace:*",
    "@helmgear/llm-deepseek": "workspace:*",
    "@helmgear/llm-deepseek-api-key": "workspace:*",
    "@helmgear/session": "workspace:*",
    "@helmgear/settings": "workspace:*",
    "@helmgear/timeout": "workspace:*",
    "@helmgear/tool-testkit": "workspace:*",
    "@helmgear/tools": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@helmgear/cordis-plugin-loader": {
      "optional": true
    }
  }
}
