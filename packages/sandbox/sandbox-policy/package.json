{
  "name": "@helmgear/sandbox-policy",
  "description": "Per-call sandbox policy resolver and current model context: deployment fallbacks plus each session's mode and workspace root, shared by every enforcing capability family",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@helmgear/agent": "workspace:*",
    "@helmgear/sandbox": "workspace:*",
    "@helmgear/session": "workspace:*",
    "@helmgear/system-prompt": "workspace:*",
    "@helmgear/cordis": "workspace:~",
    "@helmgear/session-projection": "workspace:*"
  },
  "dependencies": {
    "@helmgear/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@helmgear/brand": "workspace:*",
    "@helmgear/agent": "workspace:*",
    "@helmgear/sandbox": "workspace:*",
    "@helmgear/session": "workspace:*",
    "@helmgear/system-prompt": "workspace:*",
    "@helmgear/cordis": "workspace:~",
    "@helmgear/session-projection": "workspace:*"
  }
}
