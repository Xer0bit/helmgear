{
  "name": "@helmgear/session-format-v0-to-v1",
  "description": "Frozen released-v0 Session codec and identity migration to v1",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "helmgear": {
    "sessionFormatMigration": {
      "from": 0,
      "to": 1,
      "export": ".",
      "migration": "sessionFormatV0ToV1",
      "sourceCodec": "releasedV0SessionFormatCodec",
      "targetCodec": "releasedV1SessionFormatCodec",
      "targetHeaderValidator": "assertReleasedV1Header",
      "targetRestorer": "restoreReleasedV1Artifact"
    }
  },
  "dependencies": {
    "@helmgear/session-format": "workspace:*",
    "@helmgear/util-time": "workspace:*",
    "@helmgear/util-values": "workspace:*"
  },
  "peerDependencies": {
    "@helmgear/cordis": "workspace:~"
  },
  "devDependencies": {
    "@helmgear/cordis": "workspace:~",
    "@helmgear/session": "workspace:*"
  }
}
