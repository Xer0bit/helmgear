{
  "name": "@helmgear/session-persistence-jsonl",
  "description": "JSONL durable session persistence backend for the Helmgear",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/worker.cjs",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@helmgear/session": "workspace:*",
    "@helmgear/session-persistence": "workspace:*",
    "@helmgear/cordis": "workspace:~"
  },
  "dependencies": {
    "@helmgear/brand": "workspace:*",
    "@helmgear/llm": "workspace:*",
    "@helmgear/session-format": "workspace:*",
    "@helmgear/session-format-catalog": "workspace:*",
    "@helmgear/session-format-v3-to-v4": "workspace:*",
    "@helmgear/node-addon-system": "workspace:~",
    "@helmgear/schemastery": "workspace:~",
    "koffi": "3.1.1",
    "p-limit": "7.3.3"
  },
  "devDependencies": {
    "@helmgear/session": "workspace:*",
    "@helmgear/session-format-v0-to-v1": "workspace:*",
    "@helmgear/session-persistence": "workspace:*",
    "@helmgear/cordis": "workspace:~"
  }
}
