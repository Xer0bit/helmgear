{
  "name": "@helmgear/tool-testkit",
  "description": "Tool definition and execution fixtures for tests and benchmarks",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@helmgear/cordis": "workspace:~",
    "@helmgear/llm": "workspace:*",
    "@helmgear/tools": "workspace:*"
  },
  "devDependencies": {
    "@helmgear/brand": "workspace:*",
    "@helmgear/cordis": "workspace:~",
    "@helmgear/llm": "workspace:*",
    "@helmgear/system-prompt": "workspace:*",
    "@helmgear/tools": "workspace:*"
  }
}
