{
  "name": "@helmgear/agent-loop-testkit",
  "description": "Prerequisite mounting, production AgentLoop drivers, and Inbox stubs for tests",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@helmgear/agent": "workspace:*",
    "@helmgear/agent-loop": "workspace:*",
    "@helmgear/llm": "workspace:*",
    "@helmgear/session": "workspace:*",
    "@helmgear/session-projection": "workspace:*",
    "@helmgear/system-prompt": "workspace:*",
    "@helmgear/tools": "workspace:*",
    "@helmgear/cordis": "workspace:~",
    "@helmgear/working-directory": "workspace:*",
    "@helmgear/fs-local": "workspace:*"
  },
  "dependencies": {
    "@helmgear/tool-executor-native": "workspace:*",
    "@helmgear/tool-executor-ptc": "workspace:*"
  },
  "devDependencies": {
    "@helmgear/brand": "workspace:*",
    "@helmgear/agent": "workspace:*",
    "@helmgear/agent-loop": "workspace:*",
    "@helmgear/llm": "workspace:*",
    "@helmgear/ptc-runtime": "workspace:*",
    "@helmgear/session": "workspace:*",
    "@helmgear/session-projection": "workspace:*",
    "@helmgear/system-prompt": "workspace:*",
    "@helmgear/tools": "workspace:*",
    "@helmgear/cordis": "workspace:~",
    "@helmgear/working-directory": "workspace:*",
    "@helmgear/fs-local": "workspace:*"
  }
}
