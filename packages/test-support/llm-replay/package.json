{
  "name": "@helmgear/llm-replay",
  "description": "Replay LLM plugin: short-circuits llm/stream with model chunks reconstructed from a recorded session JSONL (keyless snapshot tests)",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@helmgear/cordis": "workspace:~",
    "@helmgear/compaction": "workspace:*",
    "@helmgear/deepseek-llm-api-extensions": "workspace:*",
    "@helmgear/llm": "workspace:*",
    "@helmgear/session": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@helmgear/deepseek-llm-api-extensions": {
      "optional": true
    }
  },
  "devDependencies": {
    "@helmgear/cordis": "workspace:~",
    "@helmgear/compaction": "workspace:*",
    "@helmgear/deepseek-llm-api-extensions": "workspace:*",
    "@helmgear/llm": "workspace:*",
    "@helmgear/session": "workspace:*"
  },
  "dependencies": {
    "@helmgear/brand": "workspace:*",
    "@helmgear/session-format-catalog": "workspace:*",
    "@helmgear/util-values": "workspace:*"
  }
}
