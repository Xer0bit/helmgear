{
  "name": "@helmgear/skill",
  "description": "Agent skill provider registry for the Helmgear",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@helmgear/cordis": "workspace:~",
    "@helmgear/llm": "workspace:*",
    "@helmgear/error": "workspace:*",
    "@helmgear/scope": "workspace:*"
  },
  "dependencies": {
    "@helmgear/util-values": "workspace:*",
    "@helmgear/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@helmgear/cordis": "workspace:~",
    "@helmgear/llm": "workspace:*",
    "@helmgear/error": "workspace:*",
    "@helmgear/scope": "workspace:*"
  }
}
