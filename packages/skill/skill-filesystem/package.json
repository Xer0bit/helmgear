{
  "name": "@helmgear/skill-filesystem",
  "description": "Local filesystem skill provider for the Helmgear",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@helmgear/fs": "workspace:*",
    "@helmgear/home-paths": "workspace:*",
    "@helmgear/skill": "workspace:*",
    "@helmgear/cordis": "workspace:~"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "@helmgear/schemastery": "workspace:~",
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@helmgear/brand": "workspace:*",
    "@helmgear/fs": "workspace:*",
    "@helmgear/home-paths": "workspace:*",
    "@helmgear/skill": "workspace:*",
    "@helmgear/cordis": "workspace:~"
  }
}
