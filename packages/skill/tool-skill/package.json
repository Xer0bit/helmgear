{
  "name": "@helmgear/tool-skill",
  "description": "Model-facing skill loading tool for the Helmgear",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@helmgear/agent": "workspace:*",
    "@helmgear/llm": "workspace:*",
    "@helmgear/skill": "workspace:*",
    "@helmgear/tools": "workspace:*",
    "@helmgear/cordis": "workspace:~",
    "@helmgear/working-directory": "workspace:*"
  },
  "dependencies": {
    "@helmgear/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@helmgear/brand": "workspace:*",
    "@helmgear/agent": "workspace:*",
    "@helmgear/agent-loop-testkit": "workspace:*",
    "@helmgear/llm": "workspace:*",
    "@helmgear/scope": "workspace:*",
    "@helmgear/session": "workspace:*",
    "@helmgear/skill": "workspace:*",
    "@helmgear/skill-filesystem": "workspace:*",
    "@helmgear/tool-executor-native": "workspace:*",
    "@helmgear/tool-testkit": "workspace:*",
    "@helmgear/tools": "workspace:*",
    "@helmgear/cordis": "workspace:~",
    "@helmgear/working-directory": "workspace:*"
  }
}
