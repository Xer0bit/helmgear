{
  "name": "@helmgear/sdk-client",
  "description": "TypeScript client SDK for driving a Helmgear runtime subprocess over stdio JSON-RPC: the Helmgear high-level turns API and the lower-level HarnessClient",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@helmgear/brand": "workspace:*",
    "@helmgear/helmgear": "workspace:*"
  },
  "peerDependencies": {
    "@helmgear/llm": "workspace:*",
    "@helmgear/sdk-protocol": "workspace:*",
    "@helmgear/session": "workspace:*",
    "@helmgear/cordis": "workspace:~"
  },
  "devDependencies": {
    "@helmgear/llm": "workspace:*",
    "@helmgear/sdk-protocol": "workspace:*",
    "@helmgear/session": "workspace:*",
    "@helmgear/cordis": "workspace:~"
  }
}
