{
  "name": "@helmgear/config-editor",
  "description": "Persist plugin configuration through profile patches and Loader reconciliation",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@helmgear/cordis": "workspace:~",
    "@helmgear/cordis-plugin-loader": "workspace:~",
    "@helmgear/hmr": "workspace:*",
    "@helmgear/cordis-plugin-include": "workspace:~",
    "@helmgear/app-boot": "workspace:*"
  },
  "dependencies": {
    "@helmgear/atomic-write": "workspace:*",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@helmgear/cordis": "workspace:~",
    "@helmgear/cordis-plugin-loader": "workspace:~",
    "@helmgear/hmr": "workspace:*",
    "@helmgear/cordis-plugin-include": "workspace:~",
    "@helmgear/app-boot": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@helmgear/hmr": {
      "optional": true
    }
  }
}
