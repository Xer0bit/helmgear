{
  "name": "@helmgear/compaction-image-offload",
  "description": "Durable image offload for image-capable routes: replace over-budget request images with placeholders and retry",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./projection": {
      "types": "./lib/types/projection.d.ts",
      "default": "./lib/types/projection.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@helmgear/cordis": "workspace:~",
    "@helmgear/agent": "workspace:*",
    "@helmgear/compaction": "workspace:*",
    "@helmgear/llm": "workspace:*",
    "@helmgear/session": "workspace:*"
  },
  "devDependencies": {
    "@helmgear/brand": "workspace:*",
    "@helmgear/cordis": "workspace:~",
    "@helmgear/agent": "workspace:*",
    "@helmgear/agent-loop": "workspace:*",
    "@helmgear/agent-loop-testkit": "workspace:*",
    "@helmgear/attachment": "workspace:*",
    "@helmgear/compaction": "workspace:*",
    "@helmgear/compaction-basic": "workspace:*",
    "@helmgear/llm": "workspace:*",
    "@helmgear/llm-deepseek": "workspace:*",
    "@helmgear/session": "workspace:*",
    "@helmgear/session-projection": "workspace:*",
    "@helmgear/token-meter": "workspace:*"
  },
  "dependencies": {
    "@helmgear/util-values": "workspace:*"
  }
}
