{
  "name": "@helmgear/compaction-basic",
  "description": "Token-meter-driven compaction policy and LLM summarization backend for the Helmgear",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@helmgear/cordis": "workspace:~",
    "@helmgear/agent": "workspace:*",
    "@helmgear/commands": "workspace:*",
    "@helmgear/compaction": "workspace:*",
    "@helmgear/compaction-tool-result-pruner": "workspace:*",
    "@helmgear/llm": "workspace:*",
    "@helmgear/session": "workspace:*",
    "@helmgear/session-projection": "workspace:*",
    "@helmgear/token-meter": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@helmgear/compaction-tool-result-pruner": {
      "optional": true
    }
  },
  "dependencies": {
    "@helmgear/brand": "workspace:*",
    "@helmgear/util-values": "workspace:*",
    "@helmgear/schemastery": "workspace:~",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@helmgear/cordis": "workspace:~",
    "@helmgear/cordis-plugin-include": "workspace:~",
    "@helmgear/cordis-plugin-loader": "workspace:~",
    "@helmgear/agent": "workspace:*",
    "@helmgear/agent-loop": "workspace:*",
    "@helmgear/agent-loop-testkit": "workspace:*",
    "@helmgear/commands": "workspace:*",
    "@helmgear/compaction": "workspace:*",
    "@helmgear/compaction-tool-result-pruner": "workspace:*",
    "@helmgear/llm": "workspace:*",
    "@helmgear/llm-retry": "workspace:*",
    "@helmgear/session": "workspace:*",
    "@helmgear/session-projection": "workspace:*",
    "@helmgear/token-meter": "workspace:*",
    "@helmgear/tool-testkit": "workspace:*",
    "@helmgear/tools": "workspace:*",
    "@helmgear/compaction-image-offload": "workspace:*"
  }
}
