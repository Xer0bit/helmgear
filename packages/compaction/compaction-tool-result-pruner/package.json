{
  "name": "@helmgear/compaction-tool-result-pruner",
  "description": "Replay-safe model-free head/middle/tail pruning for tool-result surface nodes",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@helmgear/cordis": "workspace:~",
    "@helmgear/compaction": "workspace:*",
    "@helmgear/llm": "workspace:*",
    "@helmgear/session": "workspace:*",
    "@helmgear/token-meter": "workspace:*"
  },
  "dependencies": {
    "@helmgear/util-values": "workspace:*",
    "@helmgear/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@helmgear/brand": "workspace:*",
    "@helmgear/cordis": "workspace:~",
    "@helmgear/cordis-plugin-include": "workspace:~",
    "@helmgear/cordis-plugin-loader": "workspace:~",
    "@helmgear/compaction": "workspace:*",
    "@helmgear/llm": "workspace:*",
    "@helmgear/session": "workspace:*",
    "@helmgear/session-projection": "workspace:*",
    "@helmgear/token-meter": "workspace:*",
    "@helmgear/compaction-image-offload": "workspace:*"
  }
}
