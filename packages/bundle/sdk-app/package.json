{
  "name": "@helmgear/sdk-app",
  "description": "The SDK stdio startup provider used by the Helmgear agent profile",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@helmgear/cmdline": "workspace:*",
    "@helmgear/schemastery": "workspace:~",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@helmgear/cordis": "workspace:~"
  },
  "devDependencies": {
    "@helmgear/cordis-plugin-include": "workspace:~",
    "@helmgear/cordis": "workspace:~"
  }
}
