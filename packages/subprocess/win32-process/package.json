{
  "name": "@helmgear/win32-process",
  "description": "Shared low-level Win32 process, stdio, and Job Object primitives",
  "version": "0.2.2-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@helmgear/cordis": "workspace:~",
    "@helmgear/error": "workspace:*"
  },
  "dependencies": {
    "@helmgear/lazy-require": "workspace:*",
    "koffi": "3.1.1"
  },
  "devDependencies": {
    "@helmgear/cordis": "workspace:~",
    "@helmgear/error": "workspace:*"
  }
}
